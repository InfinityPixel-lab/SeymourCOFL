# CoflNet Monitor Configuration

# Backend Server Port
PORT=3000

# Backend Server URL (used by poller)
BACKEND_URL=http://localhost:3000/api

# API Polling Interval in milliseconds (5000ms = 5 seconds)
POLL_INTERVAL=5000

# CoflNet API Endpoint (change if using different API)
# COFLNET_API=https://api.coflnet.com/api/auctions/price/

# Database file location
# DATABASE_PATH=./purchases.db

# Enable debug logging
# DEBUG=true
